# Build environment for the ros2ebpf packages: ROS 2 rolling ros-base binaries (ament_cmake,
# colcon, ros2cli) plus the BPF toolchain, for quick local runs (`make build-image in-docker-test`,
# `make in-docker-deb`). CI builds against a rolling *source* build instead: `make in-docker-ci`.
ARG ROS_DISTRO=rolling
FROM ros:${ROS_DISTRO}-ros-base
ARG ROS_DISTRO
ENV DEBIAN_FRONTEND=noninteractive
COPY install-bpftool.sh /tmp/install-bpftool.sh
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake pkg-config git ca-certificates \
      clang llvm libbpf-dev \
      libelf-dev zlib1g-dev libyaml-dev libjson-c-dev \
      python3 python3-pip python3-yaml python3-pytest python3-flake8 python3-setuptools \
      ros-${ROS_DISTRO}-ament-cmake ros-${ROS_DISTRO}-ros2cli \
      curl \
    && sh /tmp/install-bpftool.sh \
    && rm -rf /var/lib/apt/lists/* \
    && clang --version
WORKDIR /src
# /ros_entrypoint.sh (inherited) sources /opt/ros/$ROS_DISTRO/setup.bash before the command
