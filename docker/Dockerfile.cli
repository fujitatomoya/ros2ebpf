# `ros2 ebpf` CLI image: ros2cli + the ros2ebpf verb package, nothing else.
# Build from the repository root:  docker build -f docker/Dockerfile.cli -t ros2ebpf-cli .
FROM ros:rolling-ros-core
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-pip python3-yaml python3-setuptools openssh-client \
    && rm -rf /var/lib/apt/lists/*
COPY ros2ebpf /src/ros2ebpf
RUN pip3 install --no-deps --break-system-packages /src/ros2ebpf 2>/dev/null \
    || pip3 install --no-deps /src/ros2ebpf
COPY docker/entrypoint-cli.sh /usr/local/bin/entrypoint.sh
ENV ROS2EBPF_SOCKET=/run/ros2ebpf/control.sock
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["ros2", "ebpf", "status"]
