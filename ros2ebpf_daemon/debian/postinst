#!/bin/sh
set -e
if ! getent group ros2ebpf >/dev/null; then
    groupadd --system ros2ebpf
fi
mkdir -p /etc/ros2ebpf
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi
if [ ! -f /etc/ros2ebpf/config.yaml ]; then
    echo "ros2ebpf-daemon: copy /etc/ros2ebpf/config.example.yaml to /etc/ros2ebpf/config.yaml, edit shims:, then 'systemctl enable --now ros2ebpfd'"
fi
exit 0
