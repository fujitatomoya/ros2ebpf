<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2ebpf_daemon</name>
  <version>0.1.0</version>
  <description>ros2ebpfd: on-demand ROS 2 endpoint statistics via eBPF uprobes on librmw_implementation.so. No ROS runtime dependency.</description>
  <maintainer email="fujita.tomoya@triorb.co.jp">Tomoya Fujita</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>pkg-config</build_depend>
  <build_depend>clang</build_depend>
  <!-- no rosdep keys yet for bpftool and libbpf-dev: pass them to rosdep via skip-keys, see docs/development.md -->
  <build_depend>bpftool</build_depend>
  <depend>libbpf-dev</depend>
  <depend>libyaml-dev</depend>
  <depend>libjson-c-dev</depend>
  <!-- linked statically: a build dependency only, nothing from it is needed at runtime -->
  <build_depend>ros2ebpf_exporter</build_depend>

  <test_depend>ament_cmake_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
