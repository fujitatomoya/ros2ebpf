{
  "uid": "ros2ebpf-host",
  "title": "ROS 2 host",
  "tags": [
    "ros2ebpf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "robot",
        "label": "robot",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"ros2ebpf\"}, robot)",
          "refId": "robot"
        },
        "definition": "label_values(up{job=\"ros2ebpf\"}, robot)",
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        }
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ros2ebpf_host_info{robot=\"$robot\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(ros2ebpf_host_info{robot=\"$robot\"}, host)",
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        }
      },
      {
        "name": "topic",
        "label": "topic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ros2_rmw_publish_total{robot=\"$robot\",host=\"$host\"}, topic)",
          "refId": "topic"
        },
        "definition": "label_values(ros2_rmw_publish_total{robot=\"$robot\",host=\"$host\"}, topic)",
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Host info",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ros2ebpf_host_info{robot=\"$robot\",host=\"$host\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Publish rate per process / topic",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (comm, topic) (rate(ros2_rmw_publish_total{robot=\"$robot\",host=\"$host\"}[1m]))",
          "legendFormat": "{{comm}} {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "hertz"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Take rate per process / topic",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (comm, topic) (rate(ros2_rmw_take_total{robot=\"$robot\",host=\"$host\"}[1m]))",
          "legendFormat": "{{comm}} {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "hertz"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "heatmap",
      "title": "Inter-publish interval heatmap ($topic)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (rate(ros2_rmw_publish_period_seconds_bucket{robot=\"$robot\",host=\"$host\",topic=\"$topic\"}[1m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Inter-publish interval p50 / p99 ($topic)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ros2_rmw_publish_period_seconds_bucket{robot=\"$robot\",host=\"$host\",topic=\"$topic\"}[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ros2_rmw_publish_period_seconds_bucket{robot=\"$robot\",host=\"$host\",topic=\"$topic\"}[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Service requests / responses",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, side) (rate(ros2_rmw_service_request_total{robot=\"$robot\",host=\"$host\"}[1m]))",
          "legendFormat": "req {{service}} {{side}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, side) (rate(ros2_rmw_service_response_total{robot=\"$robot\",host=\"$host\"}[1m]))",
          "legendFormat": "resp {{service}} {{side}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "hertz"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "UDP receive-queue drops (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (port, comm) (increase(ros2_udp_rcvbuf_drop_total{robot=\"$robot\",host=\"$host\"}[5m]))",
          "legendFormat": "{{comm}}:{{port}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "table",
      "title": "Processes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ros2_process_info{robot=\"$robot\",host=\"$host\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  }
}